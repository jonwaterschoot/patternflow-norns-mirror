# Build output
.pio/
build/
*.bin
*.elf

# Generated by tools/hosttest/run.sh — regenerated from the vendored core on
# every run, so it is never worth committing.
tools/hosttest/stub/features/pf_feature.h
tools/hosttest/stub/features/screencast/

# The one file that must never be committed: net_config.h bakes it straight
# into the image, so a build made with it carries your Wi-Fi password in
# plaintext. Upstream gitignores it for the same reason.
patternflow_secrets.h

__pycache__/
*.pyc
.DS_Store
